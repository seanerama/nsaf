# ============================================
# NSAF — Nightshift AutoFoundry Configuration
# ============================================
# Copy this file to .env and fill in all values.

# --- AI API Keys (Idea Generation) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
NSAF_OWNER_EMAIL=

# --- Webex Bot ---
WEBEX_BOT_TOKEN=
WEBEX_WEBHOOK_SECRET=
WEBEX_OWNER_PERSON_ID=

# --- ngrok (required for Webex webhook) ---
NGROK_AUTHTOKEN=

# --- Coolify (Self-Hosted PaaS for Promotion) ---
COOLIFY_API_URL=https://coolify.yourdomain.com
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT=production
NSAF_DOMAIN=yourdomain.com

# --- GitHub (for `promote` / `gitpush`) ---
# The GitHub user/org that promoted apps are published under.
# `gh` CLI must be authenticated as a user with write access to this account.
NSAF_GH_USER=your-github-user

# URL embedded in generated app READMEs as the "Built by Nightshift AutoFoundry" link.
NSAF_REPO_URL=https://github.com/your-github-user/nsaf

# Banner image shown at the top of the morning ideas email.
# Falls back to a generic placeholder if unset.
NSAF_BANNER_URL=

# --- Study guide promotion (`promote study <slug>`) ---
# Local path to the Astro website repo where promoted study guides are written.
NSAF_WEBSITE_REPO=
# Path to the `bun` binary used to run the website build (default: `bun` on PATH).
BUN_PATH=bun

# --- PostgreSQL (App Databases) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Orchestrator Settings ---
NSAF_PROJECTS_DIR=./projects
NSAF_PORT_RANGE_START=5020
NSAF_PORT_RANGE_END=5999
NSAF_CONCURRENCY=2
NSAF_STALL_TIMEOUT_MINUTES=30
NSAF_POLL_INTERVAL_SECONDS=30
NSAF_QUEUE_POLL_INTERVAL_SECONDS=10

# --- Flask App ---
NSAF_FLASK_PORT=5000
NSAF_FLASK_HOST=0.0.0.0

# --- Claude Code ---
# Default command used to spawn unattended Claude Code build sessions.
# NOTE: NSAF is designed to run autonomous builds in throwaway project dirs.
# If you trust your sandboxing, you can append `--dangerously-skip-permissions`
# to skip per-tool approval prompts. Do not do this on a machine where the
# Claude session can read or modify anything you care about.
NSAF_CLAUDE_COMMAND=claude -p "{prompt}"

# --- Database Path ---
NSAF_DB_PATH=./nsaf.db

# --- Daily-Brief integration (`brief` Webex commands) ---
# Path on the server to the Daily-Brief install (separate repo).
# All profiles, history, and rendered briefs live under $NSAF_BRIEF_HOME/data/.
# The orchestrator spawns Claude with cwd=$NSAF_BRIEF_HOME for /brief:run / /brief:topic.
NSAF_BRIEF_HOME=
